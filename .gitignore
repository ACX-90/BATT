# 仿真输出与绘图结果
Data/*
!Data/ai_mlp/
Fig/

# Data/ai_mlp：先全忽略，再放行小文件和非 epoch 的 pt
Data/ai_mlp/**
!Data/ai_mlp/config.json
!Data/ai_mlp/scaler.json
!Data/ai_mlp/history.json
!Data/ai_mlp/*.pt
Data/ai_mlp/epoch_*.pt

!Data/ai_mlp/ckpts/
Data/ai_mlp/ckpts/**
!Data/ai_mlp/ckpts/latest.json
Data/ai_mlp/ckpts/epoch_*.pt

# Data/ai_kf：滤波日志与增量权重；epoch 大文件不传
!Data/ai_kf/
Data/ai_kf/**
!Data/ai_kf/*.json
!Data/ai_kf/incr/
Data/ai_kf/incr/**
!Data/ai_kf/incr/*.json
!Data/ai_kf/incr/*.pt
Data/ai_kf/incr/epoch_*.pt
!Data/ai_kf/incr/ckpts/
Data/ai_kf/incr/ckpts/**
!Data/ai_kf/incr/ckpts/latest.json
Data/ai_kf/incr/ckpts/epoch_*.pt

# Python 缓存
__pycache__/
*.pyc
